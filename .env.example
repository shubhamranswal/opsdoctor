# ==========================================
# OpsDoctor - Environment Variables
# Copy this file to .env and set local values.
# NEVER commit real credentials to Git.
# ==========================================

# Google Gemini API
GEMINI_API_KEY=

# PayPal Sandbox (AcmeFlow Test Environment)
# Obtain from https://developer.paypal.com/dashboard/ -> Apps & Credentials (Sandbox)
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
